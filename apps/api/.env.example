# apps/api — copy to .env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
PORT=3001

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
API_URL=http://localhost:3001

# AI — leave blank to skip AI features locally
ANTHROPIC_API_KEY=

# Email — leave blank to skip email delivery locally (contacts still saved to DB)
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# CORS — comma-separated origins allowed
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Cal.com booking — get API key from cal.com/settings/developer/api-keys
# Get event type ID from your Cal.com event URL (e.g. cal.com/yourname/30min -> Settings)
# Leave blank to disable AI booking tools (chatbot will use inline lead capture form instead)
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Admin seed — set to create first admin user on startup/seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
