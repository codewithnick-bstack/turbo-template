{
  "name": "platform-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.18.3",
    "@repo/auth": "workspace:*",
    "@repo/ai": "workspace:*",
    "@repo/billing": "workspace:*",
    "@repo/search": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/schemas": "workspace:*",
    "dotenv": "^16.5.0",
    "hono": "^4.6.14",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "vitest": "^3.1.1"
  }
}
