# Root env — shared defaults. Per-app envs live in apps/*/.env.example.

# apps/web (renderer)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4100
REVALIDATE_SECRET=change-me

# Legacy apps/api (deprecated in Phase 3)
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
CONTACT_FROM_EMAIL=hello@example.com
CONTACT_TO_EMAIL=owner@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Legacy apps/cron (subsumed by apps/worker in Phase 2)
CRON_SCHEDULE=*/30 * * * *
SITEMAP_URL=http://localhost:3000/sitemap.xml
INDEXNOW_HOST=localhost
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Shared infra
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev
REDIS_URL=redis://localhost:6379

# Object storage (Phase 2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=platform-media
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/platform-media

# Auth (Phase 1) — provider chosen at runtime, leave empty to use mock
AUTH_PROVIDER=mock
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
SESSION_SECRET=change-me-32-bytes-min-change-me-change

# Billing (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_AGENCY_MONTHLY=price_xxxxxxxx

# R2 / Cloudflare
R2_ACCOUNT_ID=

# AI (Phase 4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Observability (Phase 0+)
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Captcha (Phase 3)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
