# ─────────────────────────────────────────────────────────────────────────────
# Root .env.example — copy to .env, then copy per-app files too (see below).
#
# Per-app env files:
#   apps/platform-api/.env.example  → apps/platform-api/.env
#   apps/admin/.env.example         → apps/admin/.env
#   apps/mcp/.env.example           → apps/mcp/.env
#   apps/worker/.env.example        → apps/worker/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ────────────────────────────────────────────────────────────
# Start with: pnpm db:up  (spins up Postgres + Redis + MinIO via docker compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev
REDIS_URL=redis://localhost:6379

# Object storage — MinIO for local dev, Cloudflare R2 for production
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=platform-media
R2_PUBLIC_URL=http://localhost:9000/platform-media
R2_ACCOUNT_ID=

# ── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_PROVIDER=mock  works out of the box, no setup needed.
# Switch to "workos" or "clerk" and fill the keys to enable real SSO.
AUTH_PROVIDER=mock
SESSION_SECRET=change-me-32-chars-minimum-please-change
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# AI_PROVIDER=mock  returns canned responses, no API key required.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ── Billing ───────────────────────────────────────────────────────────────────
# Leave blank to use the stub billing adapter (no Stripe needed locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Leave blank to skip email delivery locally (submissions still persist).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Captcha ───────────────────────────────────────────────────────────────────
# Leave blank to disable captcha locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── Renderer (apps/web) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4100
REVALIDATE_SECRET=change-me
